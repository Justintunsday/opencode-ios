# =============================================================================
# nodejs 26.13.0 iPhoneOS build: crypto trust store is macOS-only in the
# Apple branch; iOS must skip SecTrustSettings and use the OpenSSL path
# =============================================================================
# Base:    nodejs/node v26.13.0
# Applied: by scripts/build-ios-runtime-node26.sh after 0001..0005.
#
# Why: src/crypto/crypto_context.cc guards the macOS keychain/trust-settings
# certificate reader with `#ifdef __APPLE__`, which is also true on iOS, but
# the SecTrustSettings* APIs (kSecTrustSettingsApplication,
# kSecTrustSettingsPolicy, kSecTrustSettingsResult, SecTrustSettingsCopy*
# TrustSettings, ...) only exist in the macOS Security framework. The iOS
# build failed with:
#   ../src/crypto/crypto_context.cc:328:43: error: use of undeclared
#       identifier 'kSecTrustSettingsApplication'
#   ... (same for kSecTrustSettingsPolicy/String/Result*, SecTrustSettings*)
# Guard the Apple-only trust-store implementation with
# `defined(__APPLE__) && !TARGET_OS_IPHONE` and make the system-certificate
# dispatch fall through to GetOpenSSLSystemCertificates() on iOS. Node's
# default/bundled root certificates are unaffected; only --use-system-ca on
# iOS finds no Apple keychain certificates (the macOS-only API is absent).
# =============================================================================

--- a/src/crypto/crypto_context.cc
+++ b/src/crypto/crypto_context.cc
@@ -23,6 +23,7 @@
 #include <openssl/x509.h>
 #include <openssl/x509v3.h>
 #ifdef __APPLE__
+#include <TargetConditionals.h>
 #include <Security/Security.h>
 #endif
 
@@ -293,6 +294,7 @@
 }
 
 // Indicates the trust status of a certificate.
+#if defined(__APPLE__) && !TARGET_OS_IPHONE
 enum class TrustStatus {
   // Trust status is unknown / uninitialized.
   UNKNOWN,
@@ -311,6 +313,9 @@
 
   return X509_NAME_cmp(subject, issuer) == 0;
 }
+#endif  // defined(__APPLE__) && !TARGET_OS_IPHONE
+
+// macOS-only: SecTrustSettings* APIs are not available on iOS.
 
 // The following code is loosely based on
 // https://github.com/chromium/chromium/blob/54bd8e3/net/cert/internal/trust_store_mac.cc
@@ -320,7 +325,7 @@
 // Licensed under a BSD-style license
 // See https://chromium.googlesource.com/chromium/src/+/HEAD/LICENSE for
 // details.
-#ifdef __APPLE__
+#if defined(__APPLE__) && !TARGET_OS_IPHONE
 TrustStatus IsTrustDictionaryTrustedForPolicy(CFDictionaryRef trust_dict,
                                               bool is_self_issued) {
   // Trust settings may be scoped to a single application
@@ -622,7 +627,7 @@
   }
   CFRelease(curr_anchors);
 }
-#endif  // __APPLE__
+#endif  // defined(__APPLE__) && !TARGET_OS_IPHONE
 
 #ifdef _WIN32
 
@@ -891,13 +896,13 @@
 
 static std::vector<ncrypto::X509Pointer> InitializeSystemStoreCertificates() {
   std::vector<ncrypto::X509Pointer> system_store_certs;
-#ifdef __APPLE__
+#if defined(__APPLE__) && !TARGET_OS_IPHONE
   ReadMacOSKeychainCertificates(&system_store_certs);
 #endif
 #ifdef _WIN32
   ReadWindowsCertificates(&system_store_certs);
 #endif
-#if !defined(__APPLE__) && !defined(_WIN32)
+#if (!defined(__APPLE__) || TARGET_OS_IPHONE) && !defined(_WIN32)
   GetOpenSSLSystemCertificates(&system_store_certs);
 #endif
   return system_store_certs;
