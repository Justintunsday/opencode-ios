# =============================================================================
# nodejs-mobile: compile V8's iOS platform file (platform-ios.cc) in the gyp build
# =============================================================================
#
# Base:   nodejs-mobile/nodejs-mobile update22-9-0
#         commit 106c51f95d55d1010de56a2ffd09bfb4ba819a47
# Depends: 0001-ios-build-fixes.patch, 0002, 0003
# Applied: by .github/workflows/build-runtime.yml in filename order, `git apply`.
#
# Scope:  (a) add src/base/platform/platform-ios.cc to v8.gyp's OS=="ios"
#             source list (V8's GN build already compiles it for is_ios; the
#             gyp port in nodejs-mobile omitted it);
#         (b) make its SetJitWriteProtected() resolve
#             pthread_jit_write_protect_np with dlsym(RTLD_DEFAULT) instead of a
#             link-time call, because the public iPhoneOS SDK does not export
#             the symbol at link time.
#
# IMPORTANT - this patch does NOT enable the MAP_JIT / pthread_jit_write_protect
# code path on iOS devices. The shipped iOS memory model is patch
# 0005-no-map-jit-on-ios.patch (V8_HAS_PTHREAD_JIT_WRITE_PROTECT stays 0 on iOS
# device, no MAP_JIT, plain mprotect W^X like V8 10.2 / Node 18). With the macro
# at 0 the code added here is compiled out and inert; it is retained because it
# is the correct, link-safe implementation for a future MAP_JIT experiment and
# keeps the gyp port in sync with V8's GN build.
# =============================================================================

--- a/deps/v8/src/base/platform/platform-ios.cc
+++ b/deps/v8/src/base/platform/platform-ios.cc
@@ -2,20 +2,35 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include <dlfcn.h>
+
 #include "src/base/base-export.h"
 #include "src/base/build_config.h"
 
-// pthread_jit_write_protect_np is marked as not available in the iOS
-// SDK but it is there for the iOS simulator. So we provide a thunk
-// and a forward declaration in a compilation target that doesn't
-// include pthread.h to avoid the compiler error.
-extern "C" void pthread_jit_write_protect_np(int enable);
-
+// nodejs-mobile-build-fixes: pthread_jit_write_protect_np is not exported by
+// the public iPhoneOS SDK at link time, so resolve it with dlsym(RTLD_DEFAULT)
+// at runtime instead of a direct call. This keeps the binary linkable against
+// the public SDK while still enabling V8's mac-style RWX write-protect thunk
+// wherever the symbol exists (iOS 14+). NOTE: with the shipped iOS memory model
+// V8_HAS_PTHREAD_JIT_WRITE_PROTECT is 0 on the iOS device, so this function is
+// compiled out and the call is never reached; see patch
+// 0005-no-map-jit-on-ios.patch and docs/RUNTIME_BUILD.md.
 namespace v8::base {
 
 #if V8_HAS_PTHREAD_JIT_WRITE_PROTECT && defined(V8_OS_IOS)
+namespace {
+using JitWriteProtectFn = void (*)(int);
+JitWriteProtectFn GetJitWriteProtectFn() {
+  static const JitWriteProtectFn fn = reinterpret_cast<JitWriteProtectFn>(
+      dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_np"));
+  return fn;
+}
+}  // namespace
+
 V8_BASE_EXPORT void SetJitWriteProtected(int enable) {
-  pthread_jit_write_protect_np(enable);
+  if (JitWriteProtectFn fn = GetJitWriteProtectFn()) {
+    fn(enable);
+  }
 }
 #endif
 

--- a/tools/v8_gypfiles/v8.gyp
+++ b/tools/v8_gypfiles/v8.gyp
@@ -1469,6 +1469,10 @@
           'sources': [
             '<(V8_ROOT)/src/base/debug/stack_trace_posix.cc',
             '<(V8_ROOT)/src/base/platform/platform-darwin.cc',
+            # nodejs-mobile-build-fixes: V8's GN build compiles platform-ios.cc
+            # for is_ios; the gyp build omitted it. Needed for the iOS
+            # SetJitWriteProtected implementation (inert while the macro is 0).
+            '<(V8_ROOT)/src/base/platform/platform-ios.cc',
           ]
         }],
         ['is_win', {
