-// at runtime instead of a direct call. This keeps the binary linkable against
-// the public SDK while still enabling V8's mac-style RWX write-protect thunk
-// wherever the symbol exists (iOS 14+). NOTE: with the shipped iOS memory model
-// V8_HAS_PTHREAD_JIT_WRITE_PROTECT is 0 on the iOS device, so this function is
-// compiled out and the call is never reached; see patch
-// 0005-no-map-jit-on-ios.patch and docs/RUNTIME_BUILD.md.
+// nodejs-mobile-build-fixes (patch 0006): iOS device JIT memory model.
+//
+// Device probing (iPhone SE 2, iOS 16.1.1) shows that on iOS:
+//   * mmap(MAP_JIT) is denied (EINVAL) and pthread_jit_write_protect_np is
+//     absent, so neither the macOS APRR model nor MAP_JIT can be used;
+//   * ordinary mappings DO support mprotect(PROT_READ|PROT_WRITE) and
+//     mprotect(PROT_READ|PROT_EXEC), i.e. explicit W^X toggling works;
+//   * requesting RWX silently drops PROT_EXEC.
+// V8 therefore has to run its RwxMemoryWriteScope machinery over mprotect.
+// RegisterIOSCodeRange() is called by the heap and wasm code for every
+// committed executable range; SetJitWriteProtected(0) makes them writable
+// (RW, while code is being written) and SetJitWriteProtected(1) makes them
+// executable (RX) again. This is the only executable-memory mechanism
+// available on the device; it trades macOS-style thread-local write protection
+// for explicit page-permission toggling.
 namespace v8::base {
 
-#if V8_HAS_PTHREAD_JIT_WRITE_PROTECT && defined(V8_OS_IOS)
+#if V8_OS_IOS
 namespace {
-using JitWriteProtectFn = void (*)(int);
-JitWriteProtectFn GetJitWriteProtectFn() {
-  static const JitWriteProtectFn fn = reinterpret_cast<JitWriteProtectFn>(
-      dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_np"));
-  return fn;
+struct CodeRange {
+  void* base;
+  size_t size;
+};
+
+std::mutex& CodeRangesMutex() {
+  static std::mutex mutex;
+  return mutex;
+}
+
+std::vector<CodeRange>& CodeRanges() {
+  static std::vector<CodeRange> ranges;
+  return ranges;
 }
 }  // namespace
 
+V8_BASE_EXPORT void RegisterIOSCodeRange(void* base, size_t size) {
+  if (base == nullptr || size == 0) return;
+  std::lock_guard<std::mutex> guard(CodeRangesMutex());
+  CodeRanges().push_back({base, size});
+}
+
+#if V8_HAS_PTHREAD_JIT_WRITE_PROTECT
 V8_BASE_EXPORT void SetJitWriteProtected(int enable) {
-  if (JitWriteProtectFn fn = GetJitWriteProtectFn()) {
-    fn(enable);
+  const int prot = enable ? (PROT_READ | PROT_EXEC) : (PROT_READ | PROT_WRITE);
+  std::lock_guard<std::mutex> guard(CodeRangesMutex());
+  for (const CodeRange& range : CodeRanges()) {
+    // Ignore failures: a range may have been decommitted or reused; subsequent
+    // toggles keep the mapping consistent.
+    int result = mprotect(range.base, range.size, prot);
+    USE(result);
   }
 }
-#endif
+#endif  // V8_HAS_PTHREAD_JIT_WRITE_PROTECT
+#endif  // V8_OS_IOS
 
 }  // namespace v8::base

