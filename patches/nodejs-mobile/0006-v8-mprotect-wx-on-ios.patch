# =============================================================================
# nodejs-mobile: mprotect-based W^X toggling for V8 JIT on iOS
# =============================================================================
#
# Base:   nodejs-mobile/nodejs-mobile update22-9-0
#         commit 106c51f95d55d1010de56a2ffd09bfb4ba819a47
# Depends: 0001..0005 (applied first, in filename order)
# Applied: by .github/workflows/build-runtime.yml with `git apply`.
#
# Why: device memory-permission probing on the target iPhone (iPhone SE 2,
# iOS 16.1.1, Dopamine rootless) established the ONLY executable-memory
# mechanism available:
#     plain RW -> write -> mprotect RX -> execute   : WORKS
#     mmap RWX / mprotect RWX + execute             : SIGBUS (X silently dropped)
#     MAP_JIT reservation / mprotect on it          : EINVAL
#     pthread_jit_write_protect_np                  : absent
#   (v3 trapped with SIGBUS because MAP_JIT pages stayed rw-; v4 aborted with
#   SIGTRAP/FatalProcessOOM in CodeRange::InitReservation because iOS denies
#   RWX mprotect; neither is fixable with entitlements.)
#
# This patch implements V8's RwxMemoryWriteScope over per-range mprotect:
#   * build_config.h: V8_HAS_PTHREAD_JIT_WRITE_PROTECT = 1 on iOS arm64, so the
#     write-scope machinery is compiled in and SetJitWriteProtected is called.
#   * platform.h/platform-ios.cc: RegisterIOSCodeRange() registry plus
#     SetJitWriteProtected(): mprotect every registered code range RW (enable=0,
#     writing) or RX (enable=1, executing). No MAP_JIT, no APRR.
#   * code-range.cc: never request RWX on iOS. The code-range reservation stays
#     PROT_NONE; per-MemoryChunk commits handle permissions. The re-embedded
#     builtins blob is committed RW, copied, then RX.
#   * memory-allocator.cc: on iOS commit the chunk header RW (never executed),
#     guard pages PROT_NONE, and the code body RW + RegisterIOSCodeRange() so
#     the write scopes can toggle it.
#   * wasm-code-manager.cc: register wasm code-space reservations; commit
#     wasm code RW then RX instead of RWX.
#
# The macOS implementation (pthread_jit_write_protect_np) is untouched; the iOS
# implementation is selected by V8_OS_IOS. Patch 0005 keeps MAP_JIT disabled on
# iOS; patch 0006 supplies the mechanism that 0005 made possible.
#
# Known trade-off: mprotect is process-wide, so a whole registered range is
# non-executable while a thread holds a write scope (unlike the thread-local
# macOS APRR model). This is correctness-first; startup may be slower. If the
# device shows issues, later work can restrict toggling to the exact pages being
# written.
#
# Entitlements: unchanged device-verified 2-key set
# (platform-application + com.apple.private.security.no-sandbox) - no MAP_JIT,
# no JIT-specific keys.
# =============================================================================

--- a/deps/v8/src/base/build_config.h
+++ b/deps/v8/src/base/build_config.h
@@ -29,11 +29,15 @@
 
 // pthread_jit_write_protect is only available on arm64 Mac.
 
-// nodejs-mobile patch: disable V8_HAS_PTHREAD_JIT_WRITE_PROTECT 
-// for ios's arm64-simulator and x64-simulator. and 'embedtest' from node.gyp as well.
-// this removes SetJitWriteProtected forward declaration from build
+// nodejs-mobile-build-fixes (patch 0006): enable V8's RwxMemoryWriteScope
+// machinery on the iOS device as well. On iOS the implementation behind
+// SetJitWriteProtected is a plain-mprotect RW<->RX toggler over registered code
+// ranges (platform-ios.cc), because iOS 16 only supports explicit W^X toggling:
+// MAP_JIT and pthread_jit_write_protect_np are unavailable, and RWX requests
+// silently lose PROT_EXEC (device-probed, see docs/RUNTIME_BUILD.md). macOS
+// keeps its pthread_jit_write_protect implementation.
 #if defined(V8_HOST_ARCH_ARM64) && \
-    (defined(V8_OS_MACOS) )
+    (defined(V8_OS_MACOS) || defined(V8_OS_IOS))
 #define V8_HAS_PTHREAD_JIT_WRITE_PROTECT 1
 #else
 #define V8_HAS_PTHREAD_JIT_WRITE_PROTECT 0

--- a/deps/v8/src/base/platform/platform.h
+++ b/deps/v8/src/base/platform/platform.h
@@ -691,6 +691,14 @@
 V8_BASE_EXPORT void SetJitWriteProtected(int enable);
 #endif
 
+#if V8_OS_IOS
+// nodejs-mobile-build-fixes (patch 0006): register an executable range whose
+// page permissions are toggled between RX and RW by SetJitWriteProtected().
+// The iOS implementation uses mprotect because MAP_JIT and
+// pthread_jit_write_protect_np are unavailable on iOS devices.
+V8_BASE_EXPORT void RegisterIOSCodeRange(void* base, size_t size);
+#endif  // V8_OS_IOS
+
 }  // namespace base
 }  // namespace v8
 

