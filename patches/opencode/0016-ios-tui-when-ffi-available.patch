 import { findSession } from "../../session-target"
 import { errorMessage } from "../../util/error"
-import { isInteractiveTTY, isIOS, isTUIRendererUnavailable, reportTUIUnavailable } from "../../util/ios"
+import {
+      hasNodeFFI,
+      isInteractiveTTY,
+      isIOS,
+      isTUIRendererUnavailable,
+      reportTUIUnavailable,
+    } from "../../util/ios"
 
 export default Runtime.handler(Commands, (input) =>
   Effect.gen(function* () {
     const requestedDirectory = Option.getOrUndefined(input.directory)
     const requestedServer = Option.getOrUndefined(input.server)
     if (requestedDirectory !== undefined) process.chdir(requestedDirectory)
-    // iPhoneOS has no OpenTUI native renderer (it needs Node >= 26.4 + node:ffi), so the full TUI
-    // cannot start. With a terminal, fall back to the pure-JS line REPL; without one, explain the
-    // supported headless interface instead of crashing inside the renderer with a stack trace.
-    if (isIOS()) {
+    // iPhoneOS can start the real OpenTUI TUI only when the runtime provides node:ffi (the
+    // FFI-enabled Node 26 iPhoneOS runtime; the renderer dylib is shipped in the CLI assets).
+    // Without FFI (Node 22 runtime, or a Node 26 build without FFI) keep the pure-JS line REPL in
+    // a terminal, and explain the supported headless interface for scripts/pipes.
+    const iosTuiFFIAvailable = yield* Effect.promise(() => hasNodeFFI())
+    if (isIOS() && !iosTuiFFIAvailable) {
       if (!isInteractiveTTY()) {
         yield* Effect.sync(reportTUIUnavailable)
         return
