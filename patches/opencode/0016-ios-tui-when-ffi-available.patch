diff --git a/packages/cli/src/util/ios.ts b/packages/cli/src/util/ios.ts
index 44c2ea4..de75fda 100644
--- a/packages/cli/src/util/ios.ts
+++ b/packages/cli/src/util/ios.ts
@@ -1,8 +1,10 @@
-// iPhoneOS has no OpenTUI native renderer: OpenTUI's Node binding needs Node.js >= 26.4 with
-// `--experimental-ffi` / `node:ffi` to load its native core, and the shipped iPhoneOS runtime
-// is Node 22.9 (no node:ffi). The full TUI and `opencode mini` therefore cannot start here.
-// In a terminal the CLI falls back to a pure-JS line REPL (see ios-repl.ts); scripts and pipes
-// use the normal headless commands.
+// iPhoneOS can run OpenTUI's native renderer only when the runtime provides `node:ffi`
+// (OpenTUI's Node binding needs Node.js >= 26.4 with node:ffi): the FFI-enabled Node 26
+// iPhoneOS runtime plus the staged `libopentui.dylib` renderer asset. On the Node 22.9 runtime
+// (and any Node 26 build without FFI) `node:ffi` is absent, so the full TUI and `opencode mini`
+// cannot start: in a terminal the CLI falls back to a pure-JS line REPL (see ios-repl.ts), and
+// scripts/pipes use the normal headless commands. The handlers probe `hasNodeFFI()` and only
+// take the fallback when FFI is unavailable.
 export const TUI_UNAVAILABLE_MESSAGE = `Interactive TUI is not available on this iOS build.
 OpenTUI needs Node.js >= 26.4 with node:ffi (--experimental-ffi), which this iPhoneOS
 runtime (Node ${process.versions.node}) cannot provide, so the full TUI and \`opencode mini\`
@@ -14,10 +16,30 @@ Interactive mode requires a TTY (stdin and stdout). For scripts and pipes use th
   opencode models | auth login | auth list | session list | debug paths
 Docs: /var/jb/usr/share/doc/opencode/KNOWN_LIMITATIONS.md`
 
+// Build-time marker for the node26 bundle static check in scripts/build-opencode-bundle.sh: it
+// must be present in the shipped bundle together with `hasNodeFFI`/`runIOSRepl`/`node:ffi`.
+export const IOS_TUI_FFI_GATE = "IOS_TUI_FFI_GATE"
+
 export function isIOS() {
   return (process.platform as string) === "ios" || process.env.OPENCODE_IOS === "1"
 }
 
+// True only when the running iOS build/runtime provides node:ffi (FFI-enabled Node 26 runtime).
+// Lazy + guarded so the Node 22 bundle (which has no node:ffi) keeps the line-REPL fallback and
+// never fails at module link time. Uses createRequire instead of a static/dynamic `node:ffi`
+// import so bundlers never try to resolve it at build time.
+export async function hasNodeFFI(): Promise<boolean> {
+  if (!isIOS()) return false
+  try {
+    const { createRequire } = await import("node:module")
+    const require = createRequire(import.meta.url)
+    const ffi = require("node:ffi") as { dlopen?: unknown } | undefined
+    return typeof ffi?.dlopen === "function"
+  } catch {
+    return false
+  }
+}
+
 // The line REPL needs an interactive terminal. OPENCODE_IOS_REPL_ASSUME_TTY is a host-test hook
 // (CI exercises the REPL with piped stdio on non-iOS hosts).
 export function isInteractiveTTY() {
@@ -30,7 +52,12 @@ export function isInteractiveTTY() {
 export function isTUIRendererUnavailable(error: unknown) {
   const text = String(error instanceof Error ? error.message : error)
   return (
-    text.includes("Failed to initialize OpenTUI render library") || text.includes("Unsupported OpenTUI Node asset target")
+    text.includes("Failed to initialize OpenTUI render library") ||
+    text.includes("Unsupported OpenTUI Node asset target") ||
+    // The iOS renderer asset is staged under the CLI assets dir; partial installs must degrade to
+    // the guidance instead of an OpenTUI stack trace.
+    text.includes("Missing OpenTUI asset") ||
+    text.includes("OpenTUI native library does not exist")
   )
 }
 
