+import { TextAttributes } from "@opentui/core"
+import { Show } from "solid-js"
+import { useTheme } from "../context/theme"
+import { mobileViewport } from "../util/mobile"
+
+export function MobileHome(props: { width: number; height: number; status: string }) {
+  const theme = useTheme()
+  const viewport = () => mobileViewport(props.width, props.height)
+  return (
+    <box width="100%" flexShrink={0} paddingTop={viewport().short ? 0 : 1}>
+      <box flexDirection="row" justifyContent="space-between" height={1} gap={1}>
+        <text fg={theme.text.base} attributes={TextAttributes.BOLD}>
+          OpenCode
+        </text>
+        <text fg={theme.text.muted}>{props.status}</text>
+      </box>
+      <Show when={!viewport().short}>
+        <text fg={theme.text.base} marginTop={1}>
+          What would you like to build?
+        </text>
+      </Show>
+      <text fg={theme.text.muted} wrapMode="none" truncate>
+        {viewport().hints}
+      </text>
+    </box>
+  )
+}
