diff --git a/packages/tui/test/mobile-terminal.test.ts b/packages/tui/test/mobile-terminal.test.ts
new file mode 100644
index 0000000..35947be
--- /dev/null
+++ b/packages/tui/test/mobile-terminal.test.ts
@@ -0,0 +1,98 @@
+import { expect, test } from "bun:test"
+import { CliRenderer, TextRenderable } from "@opentui/core"
+import { ManualClock } from "@opentui/core/testing"
+import { Readable, Writable } from "node:stream"
+import { resolve } from "../src/config"
+import { mobileViewport, terminalRendererOptions } from "../src/util/mobile"
+
+test("iOS defaults use reduced motion without overriding explicit preferences", () => {
+  const mobile = resolve({}, { terminalSuspend: false, mobile: true })
+  expect(mobile.animations).toBe(false)
+  expect(mobile.cursor).toEqual({ style: "line", blinking: false })
+  const custom = resolve(
+    { animations: true, cursor: { style: "block", blinking: true } },
+    {
+      terminalSuspend: false,
+      mobile: true,
+    },
+  )
+  expect(custom.animations).toBe(true)
+  expect(custom.cursor).toEqual({ style: "block", blinking: true })
+  expect(resolve({}, { terminalSuspend: true }).cursor).toEqual({ style: "block", blinking: true })
+})
+
+test("phone viewport reserves room for input when the software keyboard reduces its height", () => {
+  expect(mobileViewport(40, 12)).toMatchObject({ compact: true, short: true, usable: true, padding: 1, promptRows: 3 })
+  expect(mobileViewport(28, 8)).toMatchObject({ usable: true, promptRows: 2 })
+  expect(mobileViewport(16, 5).usable).toBe(false)
+  expect(mobileViewport(100, 30).compact).toBe(false)
+  expect(mobileViewport(100, 12).compact).toBe(true)
+})
+
+test("iOS renderer envelopes changed frames, suppresses idle output and restores the terminal", async () => {
+  const writes: Buffer[] = []
+  const stdout = Object.assign(
+    new Writable({
+      write(chunk, _encoding, complete) {
+        writes.push(Buffer.from(chunk))
+        complete()
+      },
+    }),
+    { isTTY: true, columns: 40, rows: 12, getColorDepth: () => 24 },
+  ) as unknown as NodeJS.WriteStream
+  const stdin = new Readable({ read() {} }) as NodeJS.ReadStream
+  const renderer = new CliRenderer(stdin, stdout, 40, 12, {
+    ...terminalRendererOptions("ios"),
+    clock: new ManualClock(),
+    consoleMode: "disabled",
+    remote: true,
+    environment: { TERM: "xterm-256color" },
+    exitOnCtrlC: false,
+  })
+  try {
+    await renderer.setupTerminal()
+    // A legacy terminal reports no synchronized-update capability.
+    stdin.emit("data", Buffer.from("\x1b[?2026;0$y"))
+    const text = new TextRenderable(renderer, { content: "Ready", height: 1 })
+    renderer.root.add(text)
+    writes.length = 0
+    await renderer["loop"]()
+    await renderer["nativeSession"].idle()
+    const frame = Buffer.concat(writes).toString()
+    expect(frame.indexOf("\x1b[?2026h")).toBeLessThan(frame.indexOf("Ready"))
+    expect(frame).toContain("\x1b[?2026l")
+    expect(renderer.targetFps).toBe(20)
+    expect(renderer.maxFps).toBe(20)
+    // Startup capability replies can invalidate the first paint on macOS.
+    // Observe two genuinely quiet frames before measuring steady-state output.
+    let quiet = 0
+    for (let pass = 0; pass < 10 && quiet < 2; pass++) {
+      writes.length = 0
+      await renderer["loop"]()
+      await renderer["nativeSession"].idle()
+      quiet = Buffer.concat(writes).length === 0 ? quiet + 1 : 0
+    }
+    expect({ quiet, lastOutput: Buffer.concat(writes).toString() }).toMatchObject({ quiet: 2 })
+    writes.length = 0
+    for (let frame = 0; frame < 3; frame++) {
+      await renderer["loop"]()
+      await renderer["nativeSession"].idle()
+    }
+    expect(Buffer.concat(writes).length).toBe(0)
+    for (let index = 0; index < 30; index++) text.content = `Reply ${index}`
+    await renderer["loop"]()
+    await renderer["nativeSession"].idle()
+    const changed = Buffer.concat(writes).toString()
+    // A diff emits changed cells, rather than repeating the unchanged "Re".
+    expect(changed).toContain("29")
+    expect(changed.match(/\x1b\[\?2026h/g)?.length).toBe(1)
+    expect(changed).not.toContain("\x1b[2J")
+    expect(changed).not.toContain("\x1b[?1049h")
+  } finally {
+    renderer.destroy()
+    await renderer.closed
+  }
+  const restored = Buffer.concat(writes).toString()
+  expect(restored).toContain("\x1b[?1049l")
+  expect(restored).toContain("\x1b[?25h")
+})
