--- /dev/null
+++ b/packages/tui/src/util/mobile.ts
@@ -0,0 +1,27 @@
+import type { CliRendererConfig } from "@opentui/core"
+
+export function mobileViewport(width: number, height: number) {
+  const compact = width < 72 || height < 20
+  return {
+    compact,
+    narrow: width < 72,
+    short: height < 16,
+    usable: width >= 24 && height >= 8,
+    padding: compact ? 1 : 2,
+    promptRows: compact ? Math.max(1, Math.min(3, Math.floor(height / 4))) : Math.max(6, Math.floor(height / 3)),
+    hints: width < 40 ? "/models  /exit" : "/models  /sessions  /exit",
+  }
+}
+
+export function terminalRendererOptions(platform: string = process.platform): CliRendererConfig {
+  if (platform !== "ios") return { targetFps: 60, useKittyKeyboard: {} }
+  // NewTerm may not advertise synchronized output. Always envelope complete
+  // frames, and avoid animation/resize bursts on a phone's terminal compositor.
+  return {
+    targetFps: 20,
+    maxFps: 20,
+    debounceDelay: 80,
+    synchronizedOutput: "always",
+    useKittyKeyboard: null,
+  }
+}
