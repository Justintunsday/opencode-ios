@@ -0,0 +1,64 @@
+import { expect, test } from "bun:test"
+import { TextareaRenderable } from "@opentui/core"
+import { createAppFixture } from "./fixture/app"
+
+test("phone home keeps the composer and commands visible with the keyboard open", async () => {
+  await using setup = await createAppFixture({ width: 40, height: 12 })
+  await setup.ready
+  await setup.waitForFrame(() => setup.renderer.currentFocusedRenderable instanceof TextareaRenderable)
+  const input = setup.renderer.currentFocusedRenderable as TextareaRenderable
+  input.clear()
+  const frame = await setup.waitForFrame((frame) => frame.includes("Enter send"))
+  expect(frame).toContain("OpenCode")
+  expect(frame).toContain("/ commands")
+  expect(frame).toContain("/models")
+  expect(frame).toContain("/exit")
+  expect(setup.renderer.currentFocusedRenderable).toBeInstanceOf(TextareaRenderable)
+  expect(
+    frame
+      .split("\n")
+      .map((line) => line.trimEnd())
+      .join("\n"),
+  ).toMatchSnapshot()
+})
+
+test("phone resizing preserves the draft, Unicode and focused editor", async () => {
+  await using setup = await createAppFixture({ width: 40, height: 18 })
+  await setup.ready
+  await setup.waitForFrame(() => setup.renderer.currentFocusedRenderable instanceof TextareaRenderable)
+  const input = setup.renderer.currentFocusedRenderable as TextareaRenderable
+  input.clear()
+  const draft = "中文 café e\u0301 👩‍💻 مرحبا"
+  await setup.mockInput.pasteBracketedText(draft)
+  await setup.waitForFrame(() => input.plainText === draft)
+  for (const [width, height] of [
+    [28, 10],
+    [16, 5],
+    [100, 30],
+    [40, 12],
+  ]) {
+    setup.resize(width, height)
+    await setup.renderOnce()
+    expect(input.plainText).toBe(draft)
+    expect(setup.renderer.currentFocusedRenderable).toBe(input)
+    if (width === 16) expect(setup.captureCharFrame()).toContain("Resize")
+  }
+  expect(setup.captureCharFrame()).toContain("Enter send")
+  input.clear()
+  await setup.waitForFrame(() => input.plainText === "")
+})
+
+test.each(["dark", "light"] as const)("phone commands remain keyboard-accessible in %s mode", async (mode) => {
+  await using setup = await createAppFixture({ width: 40, height: 18, config: { animations: false, theme: { mode } } })
+  await setup.ready
+  await setup.waitForFrame(() => setup.renderer.currentFocusedRenderable instanceof TextareaRenderable)
+  const input = setup.renderer.currentFocusedRenderable as TextareaRenderable
+  input.clear()
+  await setup.mockInput.typeText("/")
+  await setup.waitForFrame((frame) => frame.includes("models"))
+  await setup.mockInput.pressEscape()
+  await setup.waitForFrame(() => setup.renderer.currentFocusedRenderable instanceof TextareaRenderable)
+  expect(setup.captureCharFrame()).toContain("/ commands")
+  input.clear()
+  await setup.waitForFrame(() => input.plainText === "")
+})
