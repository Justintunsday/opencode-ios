diff --git a/packages/cli/src/util/ios.ts b/packages/cli/src/util/ios.ts
new file mode 100644
index 0000000..7188f16
--- /dev/null
+++ b/packages/cli/src/util/ios.ts
@@ -0,0 +1,29 @@
+// iPhoneOS has no OpenTUI native renderer (ios-arm64 asset): the interactive TUI and
+// `opencode mini` cannot start on the port. The headless CLI is the supported interface.
+export const TUI_UNAVAILABLE_MESSAGE = `Interactive TUI is not available on this iOS build.
+The OpenTUI native renderer has no iPhoneOS (ios-arm64) build, so the full TUI
+and \`opencode mini\` cannot start on this device. Use the headless CLI instead:
+  opencode run "your prompt"        # one-shot agent turn
+  opencode run -c "your prompt"     # continue the last session
+  opencode run --standalone "..."   # private server (recommended)
+  opencode models | auth login | auth list | session list | debug paths
+Docs: /var/jb/usr/share/doc/opencode/KNOWN_LIMITATIONS.md`
+
+export function isIOS() {
+  return (process.platform as string) === "ios" || process.env.OPENCODE_IOS === "1"
+}
+
+// Defensive fallback for renderer initialization failures on iOS builds.
+export function isTUIRendererUnavailable(error: unknown) {
+  const text = String(error instanceof Error ? error.message : error)
+  return (
+    text.includes("Failed to initialize OpenTUI render library") || text.includes("Unsupported OpenTUI Node asset target")
+  )
+}
+
+// Print the guidance to stderr and make the process exit 1 without a stack trace.
+// The CLI entry point exits with process.exitCode when a handler returns successfully.
+export function reportTUIUnavailable() {
+  process.stderr.write(TUI_UNAVAILABLE_MESSAGE + "\n")
+  process.exitCode = 1
+}
