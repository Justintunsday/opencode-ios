# OpenCode iOS port patch -- 0003
# Title: Optional native modules must not crash bundle startup (node-pty, photon wasm)
# Upstream: anomalyco/opencode @ e8238bae9b807b72ecfc75afd3a9fe2e6b07b944 (v2.2.5)
# Files: packages/core/src/pty/pty.node.ts
#        packages/core/src/image/photon-wasm.node.ts
# Why: the Rollup single-file bundle (inlineDynamicImports) evaluates inlined dynamic-import
#      modules at startup. (1) node-pty: no native addon exists for iPhoneOS, and its
#      top-level createRequire would throw before --version/--help can run; the require is
#      guarded and PTY spawning then fails with a clear error (the shell tool does not use
#      the PTY). The node:sea isSea() import is dropped because the bundle is non-SEA and
#      Node 22.9's node:sea lacks several newer exports. (2) photon: its wasm-bindgen module
#      reads photon_rs_bg.wasm and instantiates WebAssembly at module load, which is fatal
#      on runtimes without WebAssembly and wasted work elsewhere. The artifact path
#      resolution is guarded so the image pipeline reports 'unavailable' instead of throwing.
# Test: node --experimental-sqlite opencode.mjs --version / --help on stock Node 22.9.0
#       with no native addons next to the bundle.
# Status: required for the iPhoneOS runtime; desktop Node builds keep behaving as before.

diff --git a/packages/core/src/image/photon-wasm.node.ts b/packages/core/src/image/photon-wasm.node.ts
index 6147408..35900c4 100644
--- a/packages/core/src/image/photon-wasm.node.ts
+++ b/packages/core/src/image/photon-wasm.node.ts
@@ -1,4 +1,15 @@
 import { createRequire } from "node:module"
 
-export default process.env.OPENCODE_PHOTON_WASM_PATH ??
-  createRequire(import.meta.url).resolve("@silvia-odwyer/photon-node/photon_rs_bg.wasm")
+// iPhoneOS: the photon WebAssembly payload may be absent, and the runtime may be
+// built without WebAssembly support. Resolve the artifact defensively so importing
+// the image pipeline never throws at startup; `available` in
+// photon-normalize then reports false and image processing degrades with a clean
+// error instead of crashing the CLI.
+export default (() => {
+  if (process.env.OPENCODE_PHOTON_WASM_PATH) return process.env.OPENCODE_PHOTON_WASM_PATH
+  try {
+    return createRequire(import.meta.url).resolve("@silvia-odwyer/photon-node/photon_rs_bg.wasm")
+  } catch {
+    return ""
+  }
+})()
