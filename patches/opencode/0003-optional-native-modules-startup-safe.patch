+// iPhoneOS: no prebuilt node-pty addon exists and the bundle must never crash at
+// startup just because an optional native dependency is missing. The require is
+// wrapped so module evaluation always succeeds; spawning a PTY then fails with a
+// descriptive error (the shell tool uses pipe-based child_process execution and
+// keeps working - see docs/OPENCODE_BUILD.md).
+const pty = (() => {
+  try {
+    return createRequire(import.meta.url)(process.env.OPENCODE_NODE_PTY_PATH ?? "@lydell/node-pty") as {
+      spawn: typeof spawn
+    }
+  } catch {
+    return undefined
+  }
+})()
 
 function spawnPty(file: string, args: string[], opts: Opts): Proc {
-  const proc = pty.spawn(file, args, process.platform === "win32" && isSea() ? { ...opts, useConptyDll: true } : opts)
+  if (!pty) throw new Error("node-pty is unavailable on this platform (iPhoneOS: no PTY addon)")
+  const proc = pty.spawn(file, args, opts)
