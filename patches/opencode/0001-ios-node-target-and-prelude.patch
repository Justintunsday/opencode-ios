+// iPhoneOS has no prebuilt Node native addons (@lydell/node-pty-*, @parcel/watcher-*,
+// @ff-labs/fff-*, ffi-rs), no persistent-PTY binary, and the shipped runtime is
+// compiled with WebAssembly disabled. Stage only the platform-independent payloads
+// the CLI can use: attention sounds, the photon wasm artifact (optional - it is
+// kept for a future runtime with WebAssembly, image processing degrades without it)
+// and the OpenTUI tree-sitter JS/wasm payloads. Native desktop binaries are
+// intentionally omitted so the artifact never ships a macOS dylib/addon that
+// cannot load on iOS.
+async function collectIosNodeAssets() {
+  const parserAssets = getNodeAssets({ platform: "darwin", arch: "arm64" }).filter(
+    (asset) => !asset.key.endsWith(".dylib"),
+  )
+  const assets: NodeAsset[] = [
+    ...parserAssets,
+    { key: photonWasmAsset, source: fileURLToPath(import.meta.resolve(photonWasmAsset)) },
+    ...attentionSoundAssets.map((key) => ({
+      key,
+      source: path.resolve(dir, "../ui/src/assets/audio", path.basename(key)),
+    })),
+  ]
+  const unique = [...new Map(assets.map((asset) => [asset.key, asset])).values()]
+  await Promise.all(unique.map((asset) => stat(asset.source)))
+  return unique
+}
