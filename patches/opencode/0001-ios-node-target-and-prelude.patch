+// Node 22.9 (the iPhoneOS runtime) stores the raw Content-Length header string in
+// ServerResponse._contentLength, so @effect/platform-node enabling
+// strictContentLength makes every response throw ERR_HTTP_CONTENT_LENGTH_MISMATCH
+// even when the lengths match (Node fixed the header/byte comparison in later
+// lines). The device runtime is pinned to 22.9, so the iOS build skips the flag;
+// the server still sets and validates Content-Length itself.
+function iosNodeHttpPlugin(): Plugin {
+  return {
+    name: "opencode:ios-node-http",
+    enforce: "pre",
+    transform(code, id) {
+      const file = id.replaceAll("\\", "/").split("?")[0]!
+      if (!file.endsWith("/@effect/platform-node/dist/NodeHttpServer.js")) return
+      const transformed = code.replace("nodeResponse.strictContentLength = true;", "")
+      if (transformed === code) this.error("Failed to disable strictContentLength for the Node 22.9 iOS runtime")
+      return transformed
+    },
+  }
+}
