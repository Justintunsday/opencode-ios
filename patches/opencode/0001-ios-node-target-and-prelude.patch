+// iPhoneOS prelude: no SEA, no module.registerHooks, no node:sea import and no
+// native addon paths. Node 22.9 (the shipped runtime) is missing all of those or
+// cannot dlopen macOS binaries, so the generated bundle must start with nothing
+// but stock Node builtins. Assets are read from a real directory; the launcher may
+// override the root with OPENCODE_NODE_ASSETS_DIR. Optional native features are
+// left unconfigured so the port's optional-native patches take the documented
+// graceful fallback instead of pointing at a payload that cannot load on iOS.
+function iosNodePrelude() {
+  return `#!/usr/bin/env -S node --experimental-sqlite --disable-warning=ExperimentalWarning
+// opencode-ios-prelude: non-SEA / Node 22.9-safe bootstrap for iPhoneOS
+import __cjs_mod__ from "node:module"
+import { fileURLToPath as __ocFileURLToPath } from "node:url"
+const __filename = import.meta.filename
+const __dirname = import.meta.dirname
+const require = __cjs_mod__.createRequire(import.meta.url)
+process.env.OPENCODE_PRELUDE = "opencode-ios-prelude-v1"
+const __ocAssetRoot =
+  process.env.OPENCODE_NODE_ASSETS_DIR ?? __ocFileURLToPath(new URL("./assets/", import.meta.url))
+process.env.OPENCODE_NODE_ASSETS_DIR = __ocAssetRoot
+process.env.OTUI_ASSET_ROOT = __ocAssetRoot
+if (!process.env.OPENCODE_IOS) process.env.OPENCODE_IOS = "1"
+// Rootless iOS has no POSIX tools in /bin: shells, git, rg and friends live under
+// the jailbreak prefix. Guarantee that prefix is on PATH (the launcher normally
+// sets it) before any tool lookup or child process runs.
+if (process.platform === "ios") {
+  const __ocIosPaths = ["/var/jb/bin", "/var/jb/usr/bin", "/var/jb/usr/sbin", "/var/jb/sbin"]
+  const __ocPathEntries = (process.env.PATH ?? "").split(":").filter(Boolean)
+  const __ocMissingPaths = __ocIosPaths.filter((dir) => !__ocPathEntries.includes(dir))
+  if (__ocMissingPaths.length > 0) process.env.PATH = [...__ocMissingPaths, ...__ocPathEntries].join(":")
+}`
+}
