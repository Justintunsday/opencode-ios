# OpenCode iOS 0017: require a real TTY before the FFI-capable TUI path.
# Device regression: with node:ffi present, redirected stdin bypassed the
# old no-FFI-only guard and started the full renderer forever.
# Host smoke covers both default and mini with stdin=/dev/null.

diff --git a/packages/cli/src/util/ios.ts b/packages/cli/src/util/ios.ts
--- a/packages/cli/src/util/ios.ts
+++ b/packages/cli/src/util/ios.ts
@@ -48,6 +48,18 @@
   )
 }
 
+// A working renderer still requires interactive stdin and stdout.
+export function reportInteractiveTTYRequired() {
+  process.stderr.write(`Interactive mode requires a TTY (stdin and stdout).
+For scripts and pipes use the headless CLI:
+  opencode run "your prompt"
+  opencode run --standalone "your prompt"
+  opencode models | auth list | session list | debug paths
+Docs: /var/jb/usr/share/doc/opencode/KNOWN_LIMITATIONS.md
+`)
+  process.exitCode = 1
+}
+
