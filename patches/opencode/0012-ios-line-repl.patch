diff --git a/packages/cli/src/ios-repl.ts b/packages/cli/src/ios-repl.ts
new file mode 100644
index 0000000..1a74724
--- /dev/null
+++ b/packages/cli/src/ios-repl.ts
@@ -0,0 +1,183 @@
+// Pure-JS line REPL used on iPhoneOS, where the OpenTUI renderer cannot load (see util/ios.ts).
+// It deliberately avoids @opencode/tui and any native rendering code: a node:readline loop feeds
+// each line through the same non-interactive run pipeline that headless `opencode run` uses, so
+// streaming text, tool activity, permission/question auto-handling and Ctrl-C interruption behave
+// exactly like `opencode run` (that pipeline installs its own SIGINT handler while a turn runs).
+import { createInterface } from "node:readline"
+import { runNonInteractiveWithOptions } from "./run/run"
+import type { ServerConnection } from "./services/server-connection"
+
+export type ReplInput = {
+  readonly model?: string
+  readonly agent?: string
+  readonly continue?: boolean
+  readonly session?: string
+  readonly thinking?: boolean
+  readonly auto?: boolean
+  readonly prompt?: string
+}
+
+export type ReplOptions = {
+  readonly server: ServerConnection.Resolved
+  readonly input: ReplInput
+}
+
+const HELP = `commands:
+  /help   show this help
+  /new    start a new session on the next prompt
+  /exit   quit (Ctrl-D also quits)
+  Ctrl-C  cancel the running turn (does not quit)`
+
+export async function runIOSRepl(options: ReplOptions) {
+  const { server, input } = options
+  const interactive = Boolean(process.stdin.isTTY && process.stdout.isTTY)
+  const rl = createInterface({
+    input: process.stdin,
+    output: process.stdout,
+    prompt: interactive ? "> " : "",
+    terminal: interactive,
+    historySize: 200,
+  })
+
+  let continueSession = input.continue ?? false
+  let session = input.session
+  let finished = false
+  let busy = false
+  let eof = false
+  let resolveDone: (() => void) | undefined
+  const pending: string[] = []
+  // The run pipeline must not consume stdin: the REPL owns it.
+  process.env.OPENCODE_RUN_SKIP_STDIN = "1"
+
+  const write = (text: string) => process.stdout.write(text.endsWith("\n") ? text : text + "\n")
+  // With piped stdio readline does not render the prompt itself; write one so scripts can see it.
+  const showPrompt = () => {
+    if (!interactive) process.stdout.write("> ")
+    rl.prompt()
+  }
+  const settle = () => {
+    if (finished) return
+    finished = true
+    process.exitCode = 0
+    resolveDone?.()
+  }
+  // Piped input reaches EOF immediately; keep the loop alive until queued lines and the running
+  // turn are done, then exit cleanly (an interactive terminal keeps reading until Ctrl-D//exit).
+  const maybeFinish = () => {
+    if (!eof || busy || pending.length > 0) return
+    settle()
+  }
+  const finish = () => {
+    rl.close()
+    settle()
+  }
+  // After handling a line: keep prompting interactively, or settle once piped input is exhausted.
+  // Queued lines are drained even after EOF so scripted `/cmd` sequences all execute.
+  const respond = () => {
+    if (!eof) return showPrompt()
+    if (pending.length > 0) return drain()
+    maybeFinish()
+  }
+
+  const runTurn = async (line: string) => {
+    busy = true
+    rl.pause()
+    try {
+      // The run pipeline reports failures itself and only sets process.exitCode; reset it so one
+      // failed turn (provider/network) cannot change the REPL's eventual exit status.
+      process.exitCode = 0
+      await runNonInteractiveWithOptions(
+        {
+          server,
+          message: line.split(/\s+/).filter(Boolean),
+          continue: continueSession,
+          session: continueSession ? undefined : (session ?? input.session),
+          fork: false,
+          model: input.model,
+          agent: input.agent,
+          format: "default",
+          file: [],
+          thinking: input.thinking ?? false,
+          auto: input.auto ?? false,
+        },
+        {},
+      )
+      continueSession = true
+      session = undefined
+    } catch (error) {
+      process.exitCode = 0
+      write(`Error: ${error instanceof Error ? error.message : String(error)}`)
+    }
+    process.exitCode = 0
+    busy = false
+    rl.resume()
+    if (eof && pending.length === 0) return maybeFinish()
+    drain()
+  }
+
+  const processLine = (line: string) => {
+    if (finished) return
+    if (line === "/exit" || line === "/quit") return finish()
+    if (line === "/help") {
+      write(HELP)
+      return respond()
+    }
+    if (line === "/new") {
+      continueSession = false
+      session = undefined
+      write("Starting a new session on the next prompt.")
+      return respond()
+    }
+    if (line.startsWith("/")) {
+      write(`Unknown command: ${line}`)
+      write(HELP)
+      return respond()
+    }
+    void runTurn(line)
+  }
+
+  // Lines typed while a turn runs (or piped input arriving ahead of the loop) are queued, not lost.
+  const drain = () => {
+    if (finished) return
+    const next = pending.shift()
+    if (next !== undefined) return processLine(next)
+    respond()
+  }
+
+  write(`opencode iOS line REPL (full TUI/OpenTUI unavailable on iPhoneOS).`)
+  write(`Type a prompt and press Enter. /help for commands, /exit or Ctrl-D to quit.`)
+  showPrompt()
+
+  rl.on("line", (raw) => {
+    if (finished) return
+    const line = raw.trim()
+    if (!line) {
+      if (!busy) respond()
+      return
+    }
+    if (busy) {
+      pending.push(line)
+      return
+    }
+    processLine(line)
+  })
+
+  // Idle Ctrl-C: keep the loop alive (during a turn the run pipeline owns SIGINT and cancels it).
+  rl.on("SIGINT", () => {
+    if (finished) return
+    process.stdout.write("\n")
+    write("(Ctrl-C cancels a running turn; /exit or Ctrl-D quits)")
+    respond()
+  })
+
+  const initial = input.prompt?.trim()
+  if (initial) processLine(initial)
+
+  await new Promise<void>((resolve) => {
+    resolveDone = resolve
+    rl.on("close", () => {
+      eof = true
+      maybeFinish()
+    })
+  })
+}
