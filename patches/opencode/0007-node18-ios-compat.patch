+// as a virtual module so `import { DatabaseSync } from "node:sqlite"` resolves at build time.
+function iosNode18SqlitePlugin(): Plugin {
+  return {
+    name: "opencode:ios-node18-sqlite",
+    enforce: "pre",
+    resolveId(id) {
+      if (id === "node:sqlite") return "\0virtual:opencode-node18-sqlite"
+    },
+    load(id) {
