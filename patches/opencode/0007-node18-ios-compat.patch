+      const shim = process.env.OPENCODE_NODE18_SQLITE_SHIM
+      if (!shim) this.error("OPENCODE_IOS_NODE18=1 requires OPENCODE_NODE18_SQLITE_SHIM")
+      return readFile(shim, "utf8")
+    },
+  }
