+// Node 18 iPhoneOS fallback prelude. The reference Node 18.20.4 iOS runtime has no
+// import.meta.filename/dirname, no global crypto, no iterator helpers and no WebAssembly-gated
+// node:sqlite; this prelude gives the bundle the small set of shims it needs (see
+// patches/opencode/0007-node18-ios-compat.patch and docs/OPENCODE_BUILD.md §13).
+function iosNode18Prelude() {
+  return `#!/usr/bin/env -S node --no-warnings
+// opencode-ios-node18-prelude: Node 18 compatible bootstrap for iPhoneOS
+import __cjs_mod__ from "node:module"
+import { fileURLToPath as __ocFileURLToPath } from "node:url"
+import __ocPath from "node:path"
+const __filename = __ocFileURLToPath(import.meta.url)
+const __dirname = __ocPath.dirname(__filename)
+const require = __cjs_mod__.createRequire(import.meta.url)
+process.env.OPENCODE_PRELUDE = "opencode-ios-node18-prelude-v1"
+const __ocAssetRoot =
+  process.env.OPENCODE_NODE_ASSETS_DIR ?? __ocFileURLToPath(new URL("./assets/", import.meta.url))
+process.env.OPENCODE_NODE_ASSETS_DIR = __ocAssetRoot
+process.env.OTUI_ASSET_ROOT = __ocAssetRoot
+if (!process.env.OPENCODE_IOS) process.env.OPENCODE_IOS = "1"
+// Rootless iOS has no POSIX tools in /bin: shells, git, rg and friends live under
+// the jailbreak prefix. Guarantee that prefix is on PATH before any tool lookup or
+// child process runs, and give the CLI a home-rooted scratch dir (no /tmp guarantee).
+if (process.platform === "ios") {
+  const __ocIosPaths = ["/var/jb/bin", "/var/jb/usr/bin", "/var/jb/usr/sbin", "/var/jb/sbin"]
+  const __ocPathEntries = (process.env.PATH ?? "").split(":").filter(Boolean)
+  const __ocMissingPaths = __ocIosPaths.filter((dir) => !__ocPathEntries.includes(dir))
+  if (__ocMissingPaths.length > 0) process.env.PATH = [...__ocMissingPaths, ...__ocPathEntries].join(":")
+  if (!process.env.TMPDIR) process.env.TMPDIR = __ocPath.join(process.env.HOME ?? "/var/jb/var/mobile", ".cache", "opencode", "tmp")
+}
+// Node 18 shipping-runtime capability shims (each guarded so newer runtimes are untouched).
+if (!globalThis.crypto) globalThis.crypto = require("node:crypto").webcrypto
+if (!Array.prototype.toSorted) Array.prototype.toSorted = function (compare) { return Array.from(this).sort(compare) }
+if (!Array.prototype.toReversed) Array.prototype.toReversed = function () { return Array.from(this).reverse() }
+if (!Array.prototype.toSpliced) Array.prototype.toSpliced = function (start, count, ...items) { const copy = Array.from(this); copy.splice(start, count, ...items); return copy }
+if (!Array.prototype.with) Array.prototype.with = function (index, value) { const copy = Array.from(this); copy[index] = value; return copy }
+if (!Array.prototype.findLast) Array.prototype.findLast = function (fn, thisArg) { for (let i = this.length - 1; i >= 0; i--) if (fn.call(thisArg, this[i], i, this)) return this[i] }
+if (!Array.prototype.findLastIndex) Array.prototype.findLastIndex = function (fn, thisArg) { for (let i = this.length - 1; i >= 0; i--) if (fn.call(thisArg, this[i], i, this)) return i; return -1 }
+if (!Object.groupBy) Object.groupBy = (items, keyFn) => { const out = Object.create(null); let i = 0; for (const item of items) { const key = keyFn(item, i++); (out[key] ??= []).push(item) } return out }
+if (!Map.groupBy) Map.groupBy = (items, keyFn) => { const out = new Map(); let i = 0; for (const item of items) { const key = keyFn(item, i++); const list = out.get(key); list ? list.push(item) : out.set(key, [item]) } return out }
+if (!Promise.withResolvers) Promise.withResolvers = () => { let resolve, reject; const promise = new Promise((res, rej) => { resolve = res; reject = rej }); return { promise, resolve, reject } }
+if (!Array.fromAsync) Array.fromAsync = async (items, mapFn) => { const out = []; let i = 0; for await (const item of items) out.push(mapFn ? await mapFn(item, i++) : item); return out }
+if (!String.prototype.isWellFormed) String.prototype.isWellFormed = function () { return !/[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?:[^\\uD800-\\uDBFF]|^)[\\uDC00-\\uDFFF]/.test(this) }
+if (!String.prototype.toWellFormed) String.prototype.toWellFormed = function () { return String(this).replace(/[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?:[^\\uD800-\\uDBFF]|^)[\\uDC00-\\uDFFF]/g, "\\uFFFD") }
+if (typeof AbortSignal !== "undefined" && !AbortSignal.any) AbortSignal.any = (signals) => { const controller = new AbortController(); for (const signal of signals) { if (signal.aborted) { controller.abort(signal.reason); break } signal.addEventListener("abort", () => controller.abort(signal.reason), { once: true }) } return controller.signal }`
