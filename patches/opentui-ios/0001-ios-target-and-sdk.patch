new file mode 100644
index 0000000..2573178
--- /dev/null
+++ b/packages/native/src/miniaudio_shim_ios.m
@@ -0,0 +1,5 @@
+// iPhoneOS: miniaudio's Apple CoreAudio backend includes <AVFoundation/AVFoundation.h> and uses
+// Objective-C syntax for AVAudioSession, so the implementation must be compiled as Objective-C.
+// This translation unit includes the shared C shim source; the build only uses it for the iOS
+// target (the other targets compile miniaudio_shim.c directly as C).
+#include "miniaudio_shim.c"
