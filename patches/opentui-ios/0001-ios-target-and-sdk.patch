+// iPhoneOS: CoreAudio/AudioToolbox cover the miniaudio CoreAudio backend (AudioUnit is a macOS
+// framework; the iOS SDK provides its symbols through AudioToolbox/libSystem). The macOS
+// NSPasteboard clipboard shim is AppKit-only, so clipboard operations report "unsupported" on iOS
+// (see src/clipboard/host.zig). No AppKit/UIKit dependency is introduced.
+//
+// No -L for the SDK usr/lib is added here: the build passes the iPhoneOS SDK as the global
+// `--sysroot`, and Zig resolves libSystem from it. Adding an explicit -L <SDK>/usr/lib gets
+// prefixed with the sysroot again by Zig's linker driver (observed as a doubled SDK path).
+fn addIOSSystemLibraries(b: *std.Build, module: *std.Build.Module, sdk_path: []const u8) void {
+    module.linkFramework("CoreFoundation", .{});
+    module.linkFramework("CoreAudio", .{});
+    module.linkFramework("AudioToolbox", .{});
+    module.linkFramework("Foundation", .{});
+    module.linkFramework("AVFoundation", .{});
+    module.addSystemIncludePath(.{ .cwd_relative = b.pathJoin(&.{ sdk_path, "usr", "include" }) });
+    module.addSystemFrameworkPath(.{ .cwd_relative = b.pathJoin(&.{ sdk_path, "System", "Library", "Frameworks" }) });
+    module.addFrameworkPath(.{ .cwd_relative = b.pathJoin(&.{ sdk_path, "System", "Library", "Frameworks" }) });
+    // No global --sysroot is passed to `zig build` (it would leak into host tools / bundled
+    // libc++). The iOS link finds the SDK's libSystem stub through this library search path.
+    module.addLibraryPath(.{ .cwd_relative = b.pathJoin(&.{ sdk_path, "usr", "lib" }) });
+    // Zig std self-info references the macOS-only private dyld API; a stub keeps the iOS dylib
+    // linkable (see the file comment).
+    module.addCSourceFile(.{
+        .file = b.path("src/opentui_ios_stubs.c"),
+        .flags = &.{ "-std=c99", "-isysroot", sdk_path },
+    });
+}
