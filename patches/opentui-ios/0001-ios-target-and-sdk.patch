diff --git a/packages/native/src/opentui_ios_stubs.c b/packages/native/src/opentui_ios_stubs.c
new file mode 100644
index 0000000..ea5f587
--- /dev/null
+++ b/packages/native/src/opentui_ios_stubs.c
@@ -0,0 +1,10 @@
+// iPhoneOS libSystem does not export the private macOS dyld API
+// _dyld_get_image_header_containing_address (the Mach-O symbol Zig's std debug self-info
+// references), so provide a stub returning NULL to keep the iOS dylib linkable. It is only
+// reachable from Zig panic/stack-trace self-info, never from OpenTUI rendering code.
+#include <stddef.h>
+
+void *_dyld_get_image_header_containing_address(const void *address) {
+    (void)address;
+    return NULL;
+}
\ No newline at end of file
