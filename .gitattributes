# Normalise line endings: CI runs bash/python on macOS and Linux.
* text=auto eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.json text eol=lf
*.patch text eol=lf
*.lock text eol=lf
*.plist text eol=lf
*.xml text eol=lf
DEBIAN/* text eol=lf
