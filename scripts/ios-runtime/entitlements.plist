<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Minimal entitlement set used to ldid-sign the iPhoneOS arm64 Node.js
	  runtime. See docs/RUNTIME_BUILD.md ("Signing and entitlements") for the
	  per-entitlement justification and limitations.

	  The shipped runtime is built with V8 --jitless and without WebAssembly,
	  so it does not require executable memory at runtime. These entitlements
	  are attached so the same binary can load on-device native addons and can
	  be re-enabled for JIT/WASM experiments without re-signing policy changes.
	  They are honoured on jailbroken (Dopamine/ElleKit) devices; they are not
	  a claim of App Store / stock-iOS compatibility.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>dynamic-codesigning</key>
	<true/>
</dict>
</plist>
