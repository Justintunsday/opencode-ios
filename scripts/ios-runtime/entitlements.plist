<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  MINIMAL, DEVICE-VERIFIED entitlement set for the iPhoneOS arm64 Node.js
	  runtime on a jailbroken (Dopamine rootless / ElleKit) device.

	  Exactly these two keys are required. On-device matrix (iPhone SE 2,
	  iPhone12,8, iOS 16.1.1, 2026-10-31, Lead-run):
	    - this 2-key set                                   -> RUNS (version check OK, exit 0)
	    - platform-application alone                       -> SIGKILL (exit 137)
	    - + dynamic-codesigning (+ allow-jit etc.)         -> SIGKILL (exit 137)
	    - platform-application + com.apple.private.security.no-sandbox -> RUNS
	  The runtime is built jitless and without WebAssembly, so JIT / executable
	  memory entitlements are not needed and are deliberately omitted.

	  See docs/RUNTIME_BUILD.md ("Signing and entitlements") for the full
	  evidence matrix and scripts/ios-runtime/README.md for re-signing on device.
	-->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
</dict>
</plist>
