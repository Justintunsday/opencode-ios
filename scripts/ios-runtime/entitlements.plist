<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  TENTATIVE entitlement set for the iPhoneOS arm64 Node.js runtime with JIT +
	  WebAssembly enabled (v4). For the earlier JIT-less v2 build the minimal
	  device-verified set was only platform-application +
	  com.apple.private.security.no-sandbox (2 keys).

	  v3 device evidence: with JIT+WASM enabled but the no-op V8 W^X code path,
	  EVERY entitlement set tested (2-key, +dynamic-codesigning, +allow-jit,
	  6-key, 9-key) still trapped with SIGBUS on generated-code execution, so the
	  trap was a V8 memory-permission bug (fixed by patch
	  0004-ios-jit-write-protect.patch), not signing.

	  With patch 0004, V8 reserves JIT code space with MAP_JIT and toggles
	  pthread_jit_write_protect_np, which on iOS requires the
	  `dynamic-codesigning` entitlement (the mechanism JIT-runner apps use on
	  jailbroken iOS 14+). `allow-unsigned-executable-memory` is included for
	  RWX/writable-code-page fallbacks. `allow-jit` and
	  `disable-library-validation` are NOT included: this set is the tentative
	  working set and the exact minimal subset is being confirmed on device; any
	  reduction is a signing-only change (cheap cached re-run).

	  Device verification status of THIS key set: PENDING (Lead device test).
	  Do not add random entitlements: on this device an unresolved extra key in
	  the old 4-key JIT set caused SIGKILL (exit 137) at load.
	-->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>dynamic-codesigning</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
