#!/bin/sh
# OpenCode iOS (rootless) — post-removal maintainer script.
#
# Cleanup policy:
#   remove: delete package-owned transient caches only; keep all user data.
#   purge:  additionally delete OpenCode *caches* under the jailbreak user home.
#           Configuration (~/.config/opencode) and session/history storage are
#           user data and are never removed by this script.
set -e

JB_ROOT=/var/jb
LIB="$JB_ROOT/usr/lib/opencode"
DOC="$JB_ROOT/usr/share/doc/opencode"

action="${1:-remove}"

remove_package_caches() {
    rm -rf "$LIB/cli/.cache" "$LIB/runtime/.cache" "$LIB/.cache"
    rm -rf "$JB_ROOT/tmp/opencode-ios-cache" "$JB_ROOT/tmp/opencode"
    # Package-owned node26 runtime asset mirror (iOS exec-mmap workaround);
    # everything else under /var/mobile/Library/OpenCode is user data.
    rm -rf /var/mobile/Library/OpenCode/assets
}

remove_user_caches() {
    # Caches only. Never touch ~/.config/opencode or ~/.local/share/opencode.
    for home in /var/mobile /var/root; do
        if [ -d "$home/.cache/opencode" ]; then
            rm -rf "$home/.cache/opencode"
        fi
        if [ -d "$home/.cache/opencode-ios" ]; then
            rm -rf "$home/.cache/opencode-ios"
        fi
    done
}

case "$action" in
    remove)
        remove_package_caches
        ;;
    purge)
        remove_package_caches
        remove_user_caches
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Keep the tree intact; dpkg owns removal of package files in these paths.
        ;;
    *)
        # Unknown action: do nothing destructive. dpkg always passes a known verb.
        ;;
esac

# Drop the doc directory if it is empty after purge; ignore failures.
if [ "$action" = "purge" ] && [ -d "$DOC" ]; then
    rmdir "$DOC" 2>/dev/null || true
fi

exit 0
