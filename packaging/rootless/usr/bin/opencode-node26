#!/var/jb/bin/sh
# OpenCode iOS (rootless) launcher — EXPERIMENTAL Node 26 (Phase D) variant.
#
# Shebang is /var/jb/bin/sh, NOT /bin/sh: on rootless iOS the kernel execs this
# file directly and /bin/sh does not exist (only /var/jb/bin/sh and
# /var/jb/usr/bin/sh). Rootless Procursus dpkg has its own shell handling, which
# is why DEBIAN/postinst etc. can keep #!/bin/sh; the launcher cannot.
# Keep this file POSIX-dash compatible.
#
# This experimental variant ships the OpenCode CLI bundle built for the native
# iPhoneOS arm64 Node.js 26.13 runtime with the OpenTUI iOS renderer
# (libopentui.dylib loaded through node:ffi, so the full interactive TUI is
# expected to work). Node 26 has node:ffi enabled by default; --experimental-ffi
# is not passed (it is accepted but redundant in 26.13).
#
# Mandatory flags:
#   --single-threaded  the iOS V8 W^X model toggles code-page permissions
#                      process-wide with mprotect; V8 background compiler/marking
#                      threads race that toggle (SIGBUS without it) — the same
#                      device-verified requirement as the Node 22.9 runtime.
#   --no-warnings      keep the CLI output clean.
# --experimental-sqlite/--disable-warning are NOT passed (not valid on the Node 26
# runtime); node:sqlite is native/stable there.
#
# OpenTUI renderer: the CLI assets include
#   cli/assets/@opentui/core-ios-arm64/libopentui.dylib
# Runtime asset root: the packaged /var/jb/usr/lib/opencode/cli/assets tree.
# Device finding (iOS 16.1.1): dyld maps ldid-signed dylibs non-executable and a
# renderer function call from such a dylib SIGBUSes, while Apple `codesign`-signed
# dylibs execute correctly from the same /var/jb path. The shipped renderer is
# therefore codesign-adhoc-signed (the node executable keeps the ldid 2-key
# signature); a /var/mobile asset tree is NOT usable because the sandbox refuses
# the dylib mmap there.
#
# Optional environment overrides (documented in docs/INSTALL.md):
#   OPENCODE_IOS_MAX_OLD_SPACE_MB  V8 old-space cap in MiB (default 1536)
#   OPENCODE_IOS_NODE_FLAGS        extra Node flags (word-split)
#   OPENCODE_IOS_PREFIX            install prefix (default /var/jb)
#   OPENCODE_IOS_NODE              alternate node binary (host smoke/diagnostics)
#   OPENCODE_IOS_RUNTIME_ASSETS    override the asset root (diagnostics only)
set -e

PREFIX="${OPENCODE_IOS_PREFIX:-/var/jb}"
LIB="$PREFIX/usr/lib/opencode"
NODE="${OPENCODE_IOS_NODE:-$LIB/runtime/node}"
CLI="$LIB/cli/opencode.mjs"
ASSETS="$LIB/cli/assets"
# Default runtime asset root is the packaged /var/jb tree; the override exists
# for diagnostics only (there is no device-usable alternative root on iOS today).
RUNTIME_ASSETS="${OPENCODE_IOS_RUNTIME_ASSETS:-$ASSETS}"

if [ ! -x "$NODE" ]; then
    echo "opencode: native runtime not found or not executable: $NODE" >&2
    echo "opencode: reinstall the experimental OpenCode-iOS-rootless-node26.deb." >&2
    exit 127
fi

if [ ! -f "$CLI" ]; then
    echo "opencode: CLI bundle not found: $CLI" >&2
    echo "opencode: reinstall the experimental OpenCode-iOS-rootless-node26.deb." >&2
    exit 127
fi

OPENCODE_IOS=1
# The OpenTUI loader resolves the renderer key
# `@opentui/core-ios-arm64/libopentui.dylib` by joining it onto this absolute
# directory; the packaged /var/jb CLI asset tree is the runtime root (the
# renderer dylib is codesign-signed so dyld maps it executable there).
OPENCODE_NODE_ASSETS_DIR="$RUNTIME_ASSETS"
OTUI_ASSET_ROOT="$RUNTIME_ASSETS"
# Rootless iOS has no /bin/sh, /bin/bash or /bin/zsh: the bootstrap shells live
# under /var/jb. Prepend the rootless bin directories so shells and tools spawned
# by the CLI (shell tool calls, git, ...) resolve without manual PATH setup.
PATH="$PREFIX/bin:$PREFIX/usr/bin:$PREFIX/usr/sbin:$PREFIX/sbin:$PATH"
export OPENCODE_NODE_ASSETS_DIR OPENCODE_IOS OTUI_ASSET_ROOT PATH

# TMPDIR fallback: some SSH/NewTerm sessions do not export TMPDIR, and the CLI /
# Node tooling need a writable temp directory.
if [ -z "${TMPDIR:-}" ]; then
    for candidate in "$PREFIX/tmp" "$PREFIX/var/tmp" /tmp; do
        if [ -d "$candidate" ] && [ -w "$candidate" ]; then
            TMPDIR="$candidate"
            break
        fi
    done
    if [ -n "${TMPDIR:-}" ]; then
        export TMPDIR
    fi
fi

MAX_OLD_SPACE="${OPENCODE_IOS_MAX_OLD_SPACE_MB:-1536}"

# Node flags must precede the entry script; CLI arguments follow the script
# path, so "$@" is preserved verbatim for the CLI.
set -- --single-threaded --no-warnings \
    "--max-old-space-size=$MAX_OLD_SPACE" "$CLI" "$@"

if [ -n "${OPENCODE_IOS_NODE_FLAGS:-}" ]; then
    # Intentional word splitting: OPENCODE_IOS_NODE_FLAGS is a list of flags.
    # shellcheck disable=SC2086
    set -- $OPENCODE_IOS_NODE_FLAGS "$@"
fi

exec "$NODE" "$@"
