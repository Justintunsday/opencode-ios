#!/var/jb/bin/sh
# OpenCode iOS (rootless) launcher — Node 18 fallback variant.
#
# Shebang is /var/jb/bin/sh, NOT /bin/sh: on rootless iOS the kernel execs this
# file directly and /bin/sh does not exist (only /var/jb/bin/sh and
# /var/jb/usr/bin/sh). Rootless Procursus dpkg has its own shell handling, which
# is why DEBIAN/postinst etc. can keep #!/bin/sh; the launcher cannot.
# Keep this file POSIX-dash compatible.
#
# This package variant ships the OpenCode CLI bundle built for the native
# iPhoneOS arm64 Node.js 18.20.4 runtime (V8 10.2 memory model, device-proven by
# the community Node 18 build on the target iPhone). The Node 18 runtime and
# bundle need:
#   * no --experimental-sqlite / --disable-warning=... / --use-system-ca (those
#     flags do not exist on Node 18; the CLI maps node:sqlite to a bundled sql.js
#     WebAssembly shim under cli/assets/node18-sqlite),
#   * a writable TMPDIR (provided below when the session does not export one),
#   * full-ICU + WebAssembly + JIT (baked into the runtime).
#
# Optional environment overrides (documented in docs/INSTALL.md):
#   OPENCODE_IOS_MAX_OLD_SPACE_MB V8 old-space cap in MiB (default 1536)
#   OPENCODE_IOS_NODE_FLAGS       extra Node flags (word-split), e.g.
#                                 OPENCODE_IOS_NODE_FLAGS="--trace-warnings"
#   OPENCODE_IOS_PREFIX           install prefix (default /var/jb); used for
#                                 host-side smoke tests of this launcher
#   OPENCODE_IOS_NODE             alternate node binary (host smoke tests only)
#
# OPENCODE_NODE_ASSETS_DIR, OPENCODE_IOS and PATH are exported for the CLI
# prelude. Provider credentials are NOT stored here: use `opencode auth login`.
set -e

PREFIX="${OPENCODE_IOS_PREFIX:-/var/jb}"
LIB="$PREFIX/usr/lib/opencode"
NODE="${OPENCODE_IOS_NODE:-$LIB/runtime/node}"
CLI="$LIB/cli/opencode.mjs"
ASSETS="$LIB/cli/assets"

if [ ! -x "$NODE" ]; then
    echo "opencode: native runtime not found or not executable: $NODE" >&2
    echo "opencode: reinstall OpenCode-iOS-rootless.deb (dpkg -i ...)." >&2
    exit 127
fi

if [ ! -f "$CLI" ]; then
    echo "opencode: CLI bundle not found: $CLI" >&2
    echo "opencode: reinstall OpenCode-iOS-rootless.deb (dpkg -i ...)." >&2
    exit 127
fi

OPENCODE_NODE_ASSETS_DIR="$ASSETS"
OPENCODE_IOS=1
# Rootless iOS has no /bin/sh, /bin/bash or /bin/zsh: the bootstrap shells live
# under /var/jb. Prepend the rootless bin directories so shells and tools spawned
# by the CLI (shell tool calls, git, ...) resolve without manual PATH setup.
PATH="$PREFIX/bin:$PREFIX/usr/bin:$PATH"
export OPENCODE_NODE_ASSETS_DIR OPENCODE_IOS PATH

# TMPDIR fallback: some SSH/NewTerm sessions do not export TMPDIR, and the CLI's
# sql.js sqlite shim / Node 18 tooling need a writable temp directory.
if [ -z "${TMPDIR:-}" ]; then
    for candidate in "$PREFIX/tmp" "$PREFIX/var/tmp" /tmp; do
        if [ -d "$candidate" ] && [ -w "$candidate" ]; then
            TMPDIR="$candidate"
            break
        fi
    done
    if [ -n "${TMPDIR:-}" ]; then
        export TMPDIR
    fi
fi

MAX_OLD_SPACE="${OPENCODE_IOS_MAX_OLD_SPACE_MB:-1536}"

# Node flags must precede the entry script; CLI arguments follow the script
# path, so "$@" is preserved verbatim for the CLI. Node 18 must NOT receive
# --experimental-sqlite / --disable-warning=... (invalid options on 18.20.4).
set -- --no-warnings "--max-old-space-size=$MAX_OLD_SPACE" "$CLI" "$@"

if [ -n "${OPENCODE_IOS_NODE_FLAGS:-}" ]; then
    # Intentional word splitting: OPENCODE_IOS_NODE_FLAGS is a list of flags.
    # shellcheck disable=SC2086
    set -- $OPENCODE_IOS_NODE_FLAGS "$@"
fi

exec "$NODE" "$@"
