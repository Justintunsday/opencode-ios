<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.opencode.root-server</string>
	<key>Program</key>
	<string>/var/jb/bin/sh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/bin/sh</string>
		<string>/var/jb/usr/local/libexec/opencode-root-server</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<key>SessionCreate</key>
	<true/>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/opencode-root-server.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/opencode-root-server.log</string>
</dict>
</plist>